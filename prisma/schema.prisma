// Prisma Schema for Sports Booking Platform
// Oracle Database compatible (requires @prisma/adapter-oracle)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core models
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  phone           String?
  role            Role      @default(PLAYER)
  avatarUrl       String?
  isPhoneVerified Boolean   @default(false)
  isVerified      Boolean   @default(false)
  noShowCount     Int       @default(0)
  cibilScore      Int       @default(750)
  bookingBanUntil DateTime?
  resetToken      String?   @unique
  resetTokenExpiry DateTime?
  address         String?
  city            String?
  state           String?
  postalCode      String?
  latitude        Float?
  longitude       Float?
  reliabilityScore Float    @default(100)
  rewardPoints      Int       @default(0)
  unlockedUntil     DateTime?
  referralCode     String?  @unique
  referredById     String?
  referrer         User?    @relation("UserReferrer", fields: [referredById], references: [id], onDelete: SetNull)
  referralsGiven   Referral[] @relation("ReferralsGiven")
  referralReceived Referral?  @relation("ReferralReceived")
  referees         User[]    @relation("UserReferrer")
  offerRecommendation OfferRecommendation?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  facilities      Facility[]
  bookings        Booking[]
  bookingParticipants BookingParticipant[]
  joinRequests        JoinRequest[]
  userTasks           UserTask[]
  tasks               Task[]
  rewardTransactions  RewardTransaction[]
  playerPreference     PlayerPreference?
  ownerPromoSettings  OwnerPromoSettings?
  taskSettings       TaskSettings?
  createdCampaigns    PromotionCampaign[] @relation("CampaignCreator")
  campaignReceipts    CampaignRecipient[]
  rewardRedemptions   RewardRedemption[]
  reviews         Review[]
  notifications   Notification[]
  pushSubscriptions PushSubscription[]
  cashfreeAccount CashfreeAccount?
  sponsor         Sponsor?
  offerRedemptions OfferRedemption[]
  teamMembers     TeamMember[]
  captainOf       Team[]    @relation("TeamCaptain")
  hostedTournaments Tournament[] @relation("TournamentHost")
  tournamentCaptains TournamentTeam[] @relation("TournamentCaptain")
  tournamentPlayers TournamentPlayer[]

}

model Facility {
  id            String   @id @default(cuid())
  name          String
  description   String?
  facilityType  String?  @default("OUTDOOR")
  contactPhone  String?
  whatsappNumber String?
  landmark      String?
  address     String
  city        String
  state       String
  country     String
  postalCode  String
  latitude    Float
  longitude   Float
  sportTypes  SportType[]
  amenities   String[]
  images      String[]
  openTime    String    @default("06:00")
  closeTime   String    @default("22:00")
  ownerId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User       @relation(fields: [ownerId], references: [id])
  courts      Court[]
  bookings    Booking[]
  reviews     Review[]
  pricingRules PricingRule[]
  availability Availability[]
  tournaments  Tournament[]
  demandForecasts DemandForecast[]
  promotionCampaigns PromotionCampaign[]
  ownerPromoSettings OwnerPromoSettings[]
}

model Court {
  id           String   @id @default(cuid())
  name         String
  facilityId   String
  sportType    SportType
  surfaceType  SurfaceType?
  capacity     Int
  dimensions   String?
  images       String[] @default([])
  isActive     Boolean  @default(true)

  facility     Facility     @relation(fields: [facilityId], references: [id])
  pricingRules PricingRule[]
  availability Availability[]
  bookings     Booking[]
  tournamentMatches TournamentMatch[]
  demandForecasts DemandForecast[]
  promotionCampaigns PromotionCampaign[]
}

model PricingRule {
  id           String   @id @default(cuid())
  facilityId   String?
  courtId      String?
  name         String
  dayOfWeek    Int[]
  startTime    String
  endTime      String
  pricePerHour Float
  minDuration  Int      @default(60)
  maxDuration  Int?
  isActive     Boolean  @default(true)

  facility     Facility? @relation(fields: [facilityId], references: [id])
  court        Court?    @relation(fields: [courtId], references: [id])
}

model Availability {
  id         String   @id @default(cuid())
  facilityId String?
  courtId    String?
  date       DateTime
  startTime  String
  endTime    String
  isBlocked  Boolean  @default(false)
  note       String?

  facility   Facility? @relation(fields: [facilityId], references: [id])
  court      Court?    @relation(fields: [courtId], references: [id])
}

model Booking {
  id              String       @id @default(cuid())
  userId          String
  facilityId      String
  courtId         String?
  teamId          String?
  startTime       DateTime
  endTime         DateTime
  duration        Int
  totalPrice      Float
  status          BookingStatus @default(PENDING)
  cashfreeOrderId String?
  cashfreePaymentId String?
  verificationCode String?   @unique
  maxPlayers      Int?      @default(1)
  offlineFriends  Int?      @default(0)
  isPublic        Boolean   @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  facility        Facility @relation(fields: [facilityId], references: [id])
  court           Court?   @relation(fields: [courtId], references: [id])
  team            Team?    @relation(fields: [teamId], references: [id])
  payment         Payment?
  review          Review?
  participants    BookingParticipant[]
  joinRequests    JoinRequest[]
  offerRedemptions OfferRedemption[]
}

model BookingParticipant {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  joinedAt  DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
}

model JoinRequest {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
}

model Payment {
  id                 String        @id @default(cuid())
  bookingId          String        @unique
  amount             Float
  platformFee        Float
  ownerPayout        Float
  cashfreePaymentId  String
  cashfreeOrderId    String
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  payoutId           String?
  payoutStatus       PayoutStatus  @default(PENDING)
  createdAt          DateTime      @default(now())

  booking            Booking       @relation(fields: [bookingId], references: [id])
}

model Sponsor {
  id            String   @id @default(cuid())
  name          String
  description   String?
  logoUrl       String?
  website       String?
  contactEmail  String
  contactPhone  String?
  budget        Float    @default(0)
  spentBudget   Float    @default(0)
  isApproved    Boolean  @default(false)
  isActive      Boolean  @default(true)
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  offers        Offer[]
}

model Offer {
  id               String     @id @default(cuid())
  sponsorId        String
  code             String     @unique
  title            String
  description      String?
  discountType     String     @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue    Float
  minBookingAmount Float      @default(0)
  maxDiscount      Float?
  validFrom        DateTime
  validTo          DateTime
  validityDays     Int        @default(30)
  maxUses          Int        @default(100)
  usedCount        Int        @default(0)
  maxUsesPerUser   Int        @default(1)
  targetAudience   String     @default("ALL") // ALL, FREQUENT, NEW, HIGH_RELIABILITY, SPECIFIC_SPORT
  targetSport      SportType?
  targetCity       String?
  imageUrl         String?
  terms            String?
  impressions      Int        @default(0)
  clicks           Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sponsor          Sponsor    @relation(fields: [sponsorId], references: [id])
  redemptions      OfferRedemption[]
  tournamentRewards TournamentReward[]
}

model OfferRedemption {
  id              String   @id @default(cuid())
  offerId         String
  userId          String
  bookingId       String?
  verificationCode String  @unique @default(cuid())
  discountApplied Float
  status          String   @default("ACTIVE") // ACTIVE, REDEEMED, EXPIRED
  redeemedAt      DateTime @default(now())
  usedAt          DateTime?

  offer           Offer    @relation(fields: [offerId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  booking         Booking? @relation(fields: [bookingId], references: [id])
}

model Tournament {
  id              String   @id @default(cuid())
  name            String
  description     String?
  sportType       SportType
  facilityId      String
  ownerId         String
  format          String   @default("KNOCKOUT")
  startDate       DateTime
  endDate         DateTime
  entryFee        Float    @default(0)
  prizePool       Float    @default(0)
  maxTeams        Int      @default(8)
  minPlayersPerTeam Int    @default(5)
  maxPlayersPerTeam Int    @default(15)
  status          String   @default("DRAFT")
  rules           String?
  imageUrl        String?
  isPublic        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility        Facility @relation(fields: [facilityId], references: [id])
  owner           User     @relation("TournamentHost", fields: [ownerId], references: [id])
  teams           TournamentTeam[]
  matches         TournamentMatch[]
  rewards         TournamentReward[]
}

model TournamentTeam {
  id            String   @id @default(cuid())
  tournamentId  String
  teamId        String?
  name          String
  captainId     String
  logoUrl       String?
  status        String   @default("REGISTERED")
  seed          Int?
  registeredAt  DateTime @default(now())

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team          Team?      @relation(fields: [teamId], references: [id])
  captain       User       @relation("TournamentCaptain", fields: [captainId], references: [id])
  players       TournamentPlayer[]
  homeMatches   TournamentMatch[] @relation("HomeTeam")
  awayMatches   TournamentMatch[] @relation("AwayTeam")
  wonMatches    TournamentMatch[] @relation("Winner")

  @@unique([tournamentId, name])
}

model TournamentPlayer {
  id                String   @id @default(cuid())
  tournamentTeamId  String
  userId            String
  role              String   @default("PLAYER")
  joinedAt          DateTime @default(now())

  team              TournamentTeam @relation(fields: [tournamentTeamId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id])

  @@unique([tournamentTeamId, userId])
}

model TournamentMatch {
  id            String   @id @default(cuid())
  tournamentId  String
  round         Int
  matchNumber   Int
  homeTeamId    String?
  awayTeamId    String?
  homeScore     Int?
  awayScore     Int?
  winnerId      String?
  status        String   @default("SCHEDULED")
  scheduledAt   DateTime?
  courtId       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam      TournamentTeam? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      TournamentTeam? @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winner        TournamentTeam? @relation("Winner", fields: [winnerId], references: [id])
  court         Court?          @relation(fields: [courtId], references: [id])
}

model TournamentReward {
  id            String   @id @default(cuid())
  tournamentId  String
  position      Int
  rewardType    String
  title         String
  description   String?
  value         Float?
  couponCode    String?
  offerId       String?
  createdAt     DateTime @default(now())

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  offer         Offer?     @relation(fields: [offerId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  facilityId  String
  bookingId   String   @unique
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  facility    Facility @relation(fields: [facilityId], references: [id])
  booking     Booking  @relation(fields: [bookingId], references: [id])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String?
  boostedUntil DateTime?
  sportType   SportType @default(FOOTBALL)
  inviteCode  String?  @unique
  captainId   String
  createdAt   DateTime @default(now())

  members     TeamMember[]
  tournamentTeams TournamentTeam[]
  bookings    Booking[]
  captain     User     @relation("TeamCaptain", fields: [captainId], references: [id])
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id])
}

model CashfreeAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  cashfreeContactId String @unique
  isVerified      Boolean  @default(false)
  bankAccountVerified Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
}

// Promotion engine models
model DemandForecast {
  id                  String   @id @default(cuid())
  facilityId          String
  courtId             String?
  date                DateTime
  hour                Int
  predictedOccupancy  Float    @default(0)
  historicalOccupancy Float    @default(0)
  demandLevel         String   @default("MEDIUM")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  facility            Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  court               Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([facilityId, courtId, date, hour])
  @@index([facilityId, date])
}

model PlayerPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  preferredSport    SportType?
  preferredTimes    Int[]    @default([])
  preferredDays     Int[]    @default([])
  lastBookingAt     DateTime?
  bookingCount30d   Int      @default(0)
  avgBookingValue   Float    @default(0)
  couponResponseScore Float  @default(0)
  engagementScore     Float  @default(0)
  inactivityDays    Int      @default(0)
  taskRecommendation Json?
  taskComputedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OwnerPromoSettings {
  id               String   @id @default(cuid())
  ownerId          String   @unique
  facilityId       String?
  enabled          Boolean  @default(true)
  maxDiscountPct   Float    @default(20)
  maxFlatDiscount  Float    @default(0)
  minBookingPrice  Float    @default(0)
  allowedDays      Int[]    @default([0,1,2,3,4,5,6])
  allowedStartHour Int      @default(0)
  allowedEndHour   Int      @default(23)
  monthlyBudget    Float    @default(0)
  spentBudget      Float    @default(0)
  autoApprove      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  facility         Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
}

model PromotionCampaign {
  id               String   @id @default(cuid())
  facilityId       String?
  courtId          String?
  name             String
  type             String
  fundingSource    String   @default("TURFPLAY")
  discountType     String   @default("PERCENTAGE")
  discountValue    Float    @default(0)
  maxDiscount      Float?
  minBookingAmount Float    @default(0)
  applicableHours  Int[]    @default([])
  applicableDays   Int[]    @default([])
  startAt          DateTime
  endAt            DateTime
  budget           Float    @default(0)
  spent            Float    @default(0)
  status           String   @default("DRAFT")
  createdBy        String?
  aiGenerated      Boolean  @default(false)
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  facility         Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  court            Court?    @relation(fields: [courtId], references: [id], onDelete: SetNull)
  creator          User?     @relation("CampaignCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  recipients       CampaignRecipient[]
  audits           PromotionAudit[]
}

model CampaignRecipient {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  couponCode  String
  isHoldout   Boolean  @default(false)
  issuedAt    DateTime @default(now())
  redeemedAt  DateTime?
  bookingId   String?

  campaign    PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model PromotionAudit {
  id          String   @id @default(cuid())
  campaignId  String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  campaign    PromotionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model RewardPerk {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  costPoints            Int
  perkType              String
  targetScope           String   @default("PLAYER")
  isActive              Boolean  @default(true)
  maxRedemptionsPerUser Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  redemptions           RewardRedemption[]
}

model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  perkId      String
  pointsSpent Int
  status      String   @default("COMPLETED")
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  perk        RewardPerk @relation(fields: [perkId], references: [id], onDelete: Cascade)
}

model PlatformPromoSettings {
  id                    String   @id @default("global")
  aiDistributionEnabled Boolean  @default(true)
  globalMaxDiscountPct  Float    @default(30)
  globalMonthlyBudget   Float    @default(0)
  updatedAt             DateTime @updatedAt
}

model TaskSettings {
  id                    String   @id @default(cuid())
  ownerId               String?  @unique
  aiEnabled             Boolean  @default(true)
  maxActiveTasks        Int      @default(5)
  maxRewardPointsPerTask Int     @default(200)
  monthlyRewardBudget   Float    @default(0)
  spentRewardBudget     Float    @default(0)
  defaultExpiryDays     Int      @default(7)
  minBookingValue       Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner                 User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model TaskTemplate {
  id            String        @id @default(cuid())
  key           String        @unique
  title         String
  description   String?
  category      TaskCategory  @default(ENGAGEMENT)
  type          TaskType
  target        Int           @default(1)
  rewardPoints  Int           @default(0)
  criteria      Json?
  isActive      Boolean       @default(true)
  approved      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Enums
enum Role {
  PLAYER
  OWNER
  ADMIN
  SPONSOR
}

enum SportType {
  FOOTBALL
  CRICKET
  TENNIS
  BADMINTON
  BASKETBALL
  VOLLEYBALL
  SWIMMING
  GYM
  MULTI_SPORT
  PICKLEBALL
  PS_GAMES
  TABLE_TENNIS
  OTHER
}

enum SurfaceType {
  GRASS
  ARTIFICIAL_TURF
  CLAY
  HARD_COURT
  WOOD
  SYNTHETIC
  WATER
  WARM_LIGHTNING_ROOM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_SUCCESS
  PAYOUT_READY
  REVIEW_RECEIVED
  SYSTEM
  OTP_VERIFICATION
}

// Task-based rewards
model Task {
  id                 String        @id @default(cuid())
  title              String
  description        String?
  type               TaskType
  category           TaskCategory  @default(ENGAGEMENT)
  target             Int           @default(1)
  rewardPoints       Int           @default(0)
  isActive           Boolean       @default(true)
  isAiGenerated      Boolean       @default(false)
  status             TaskStatus    @default(AVAILABLE)
  userId             String?
  targetTurfId       String?
  targetSport        SportType?
  targetTimeSlot     String?
  completionCriteria Json?
  verification       Json?
  startDate          DateTime      @default(now())
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userTasks          UserTask[]
}

enum TaskType {
  PLAY_GAMES
  BOOK_TURFS
  JOIN_OPEN_GAMES
  CREATE_TEAM
  REFER_FRIEND
  COMPLETE_PROFILE
  PLAY_TOURNAMENT
}

enum TaskStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum TaskCategory {
  BOOKING
  REPEAT_BOOKING
  GROUP_BOOKING
  LOYALTY
  SPORT_EXPLORATION
  WEEKEND
  COMEBACK
  ENGAGEMENT
  PROFILE
}

enum RewardTransactionStatus {
  COMPLETED
  REVERSED
  PENDING
}

model UserTask {
  id                  String      @id @default(cuid())
  userId              String
  taskId              String
  progress            Int         @default(0)
  status              TaskStatus  @default(AVAILABLE)
  completed           Boolean     @default(false)
  completedAt         DateTime?
  verifiedAt          DateTime?
  startedAt           DateTime?
  rewardTransactionId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model RewardTransaction {
  id              String                    @id @default(cuid())
  userId          String
  points          Int
  type            RewardType
  status          RewardTransactionStatus   @default(COMPLETED)
  description     String?
  referenceId     String?
  idempotencyKey  String?                   @unique
  reversalOfId    String?
  reversedAt      DateTime?
  reversalReason  String?
  createdAt       DateTime                  @default(now())

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reversalOf      RewardTransaction?        @relation("RewardReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals       RewardTransaction[]       @relation("RewardReversal")
}

enum RewardType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS
  PENALTY
}


model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  refereeId     String   @unique
  code          String
  status        String   @default("PENDING") // PENDING, COMPLETED, REWARDED
  rewardPoints  Int      @default(100)
  completedAt   DateTime?
  rewardedAt    DateTime?
  createdAt     DateTime @default(now())

  referrer      User     @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referee       User     @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model OfferRecommendation {
  id           String   @id @default(cuid())
  userId       String   @unique
  offerIds     String[]
  playerSummary Json?
  computedAt   DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
