# Production Environment for strikora.in
# Copy this to .env.production and fill in your actual values

# Database (Oracle XE in Docker)
DATABASE_URL="oracle://sys:oracle@oracle-db:1521/XEPDB1"

# NextAuth - Production URL
NEXTAUTH_URL="https://strikora.in"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth Providers - Configure in Google Cloud Console / Apple Developer
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Cashfree Payments - Get from Cashfree Merchant Dashboard
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="PRODUCTION"
CASHFREE_WEBHOOK_SECRET=""

# MSG91 (SMS/OTP) - Get from MSG91 Panel
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID_OTP=""
MSG91_TEMPLATE_ID_BOOKING_CONFIRMED=""
MSG91_TEMPLATE_ID_BOOKING_CANCELLED=""
MSG91_TEMPLATE_ID_PAYMENT_SUCCESS=""
MSG91_TEMPLATE_ID_PAYOUT_CREDITED=""
MSG91_SENDER_ID="TURFAPP"

# SendGrid (Email) - Get from SendGrid Dashboard
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@rohadas.in"
SENDGRID_FROM_NAME="Turf Booking"

# Firebase (Push Notifications) - Get from Firebase Console
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Oracle Object Storage (S3-compatible) - Get from Oracle Cloud Console
OBJECT_STORAGE_ENDPOINT="https://<namespace>.compat.objectstorage.<region>.oraclecloud.com"
OBJECT_STORAGE_REGION="<region>"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_BUCKET_FACILITY_IMAGES="facility-images"
OBJECT_STORAGE_BUCKET_DOCUMENTS="documents"
OBJECT_STORAGE_BUCKET_AVATARS="avatars"

# Redis (Docker service name)
REDIS_URL="redis://redis:6379"

# Mapbox - Get from Mapbox Account
NEXT_PUBLIC_MAPBOX_TOKEN=""

# App Config
NEXT_PUBLIC_APP_URL="https://strikora.in"
NEXT_PUBLIC_APP_NAME="Turf Booking Platform"
PLATFORM_FEE_PERCENT="10"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# File Upload
MAX_FILE_SIZE="5242880"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"

# Domain
DOMAIN="strikora.in"